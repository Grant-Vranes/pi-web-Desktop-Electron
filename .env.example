# Copy this file to .env.local and change the port for this checkout.
PORT=30141

# Optional: override the default CLI bind address (127.0.0.1).
# PI_WEB_HOSTNAME=127.0.0.1

# --- Docker (compose.yaml) ---
# `docker compose` reads .env (not .env.local). Copy this file to .env and
# replace with a long, unique secret before starting Pi Web.
# PI_WEB_PASSWORD=change-this-to-a-long-random-password

# Host-side port. Pi Web listens on 30141 inside the container.
# PI_WEB_PORT=30141

# Optional: comma-separated exact hostnames forwarded by a reverse proxy.
# PI_WEB_ALLOWED_HOSTS=

# Host workspace bind-mounted into the container. Keep both paths the same
# when reopening sessions whose saved working directories use this absolute path.
# WORKSPACE_DIR=./workspace
# WORKSPACE_CONTAINER_DIR=/workspace
